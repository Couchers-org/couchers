<email subject="{{ surfer.name }} sent you a host request">
  <para>Hi {{ user_name }},</para>
  <para>{{ surfer.name }} sent you a host request.</para>
  <user>From <b>{{ from_date }}</b> to <b>{{ to_date }}</b>.</user>
  <quote>{{ text }}</para>
  <button caption="View host request" target-url="{{ view_url }}"/>
  <button caption="Quick decline (no login needed)" target-url="{{ quick_decline_url }}"/>
</email>
