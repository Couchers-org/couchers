{
  "cli": {
    "version": ">= 10.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "macos-sequoia-15.3-xcode-16.2"
      },
      "env": {
        "COUCHERS_VARIANT": "prod"
      }
    },
    "hosted": {
      "developmentClient": true,
      "autoIncrement": true,
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "macos-sequoia-15.3-xcode-16.2"
      },
      "distribution": "store",
      "env": {
        "COUCHERS_VARIANT": "hosted"
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6623776751"
      }
    },
    "hosted": {
      "ios": {
        "ascAppId": "6623776751"
      }
    }
  }
}
