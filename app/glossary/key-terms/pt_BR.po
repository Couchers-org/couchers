#. (noun) The team behind Couchers.org.
msgid "couchers_org_team"
msgstr "Equipe Couchers.org"

#. (noun) The team behind Couchers.org, short form.
msgid "team"
msgstr "equipe"

#. (noun) The Couchers.org safety team.
msgid "safety_team"
msgstr "Equipe de segurança"

#. (noun) The Couchers.org support team.
msgid "support_team"
msgstr "Equipe de suporte"

#. (noun) The behavioral guidelines that new members must accept when joining Couchers.org.
msgid "community_guidelines"
msgstr "Diretrizes da comunidade"

#. (noun) The document outlining the legal agreement for using Couchers.org.
msgid "terms_of_service"
msgstr "Termos de serviço"

#. (noun) The https://help.couchers.org website.
msgid "help_center"
msgstr "Central de ajuda"

#. (noun) The Couchers.org blog.
msgid "blog"
msgstr "blog"

#. (noun) The activity of free hospitality welcome/exchange. Platform-agnostic.
#, fuzzy
msgid "couch surfing"
msgstr "couch surfing"

#. (verb) The act of volunteering with Couchers.org.
msgid "volunteer.verb"
msgstr "voluntariar-se"

#. (noun) A person volunteering with Couchers.org.
msgid "volunteer.noun"
msgstr "voluntário"

#. (noun) A person volunteering with Couchers.org.
msgid "volunteers"
msgstr "voluntários"

#. (verb) The act of donating money to Couchers.org.
msgid "donate"
msgstr "doar"

#. (verb) The act of donating money to Couchers.org.
msgid "donating"
msgstr "doar"

#. (noun) Money donated to Couchers.org.
msgid "donation"
msgstr "doação"

#. (noun) Money donated to Couchers.org.
msgid "donations"
msgstr "doações"

#. (noun) A problem with the platform reported by a user.
msgid "report_problem.problem"
msgstr "problema"

#. (noun) Problems with the platform reported by a user.
msgid "report_problem.problems"
msgstr "problemas"

#. (noun) As a user, the act of reporting a problem with the platform.
msgid "report_problem.report"
msgstr "reportar"

#. (noun) A user account on Couchers.org.
msgid "account"
msgstr "conta"

#. (noun) Someone with an account on Couchers.org.
msgid "user"
msgstr "usuário"

#. (noun) Someone with an account on Couchers.org.
msgid "users"
msgstr "usuários"

#. (noun) A user's account identifier on Couchers.org.
msgid "username"
msgstr "nome de usuário"

#. (noun) A user's account password on Couchers.org.
msgid "password"
msgstr "senha"

#. (verb) The action of logging in to Couchers.org.
msgid "log_in"
msgstr "fazer log in"

#. (verb) The action of logging in to Couchers.org.
msgid "logging_in"
msgstr "fazer log in"

#. (adj) The state of being logged in to Couchers.org.
msgid "logged_in"
msgstr "conectado"

#. (verb) The action of logging in to Couchers.org after logging out.
msgid "log_back_in"
msgstr "fazer login novamente"

#. (verb) The action of logging out of Couchers.org.
msgid "log_out"
msgstr "desconectar"

#. (verb) The action of logging out of Couchers.org.
msgid "logging_out"
msgstr "desconectar"

#. (adj) The state of being logged out of Couchers.org.
msgid "logged_out"
msgstr "desconectado"

#. (noun) The Couchers.org merchandise shop website.
msgid "merch_shop"
msgstr "Produtos oficiais"

#. (noun) A website/app session, from logging in to logging out.
msgid "session"
msgstr "sessão"

#. (noun) Website/app sessions, from logging in to logging out.
msgid "sessions"
msgstr "sessões"

#. (noun) A secret code used to make programmatic operations (call APIs) on behalf of a user.
msgid "api_key"
msgstr "chave API"

#. (noun) A grouping of settings (account, notifications, etc.)
msgid "settings"
msgstr "configuraçōes"

#. (noun) A user's account settings (notifications, theme, language, etc.).
msgid "account_settings"
msgstr "configuraçōes da conta"

#. (noun) An email or push notifications sent to a user.
msgid "notification"
msgstr "notificação"

#. (noun) Email or push notifications sent to a user.
msgid "notifications"
msgstr "notificações"

#. (noun) A notifications sent to a user's phone or browser.
msgid "push_notification"
msgstr "notificação por push"

#. (noun) Notifications sent to a user's phone or browser.
msgid "push_notifications"
msgstr "notificações por push"

#. (noun) A status whereby a user's identity has been verified.
msgid "strong_verification"
msgstr "Verificação forte"

#. The section of a user profile with information relating their person.
msgid "profile.about_me"
msgstr "sobre mim"

#. The section of a user profile with information relating to their home.
msgid "profile.my_home"
msgstr "minha casa"

#. (noun) A profile picture.
msgid "photo"
msgstr "foto"

#. (noun) Profile pictures.
msgid "photos"
msgstr "fotos"

#. A geographical location such as an address or the name of a city.
msgid "location"
msgstr "localização"

#. A user's willingness to host surfers.
msgid "hosting_status"
msgstr "status de hospedagem"

#. A user status whereby a user is willing to host surfers.
msgid "status.can_host"
msgstr "pode hospedar"

#. A user status whereby a user is potentially willing to host surfers.
msgid "status.may_host"
msgstr "talvez possa hospedar"

#. A user status whereby a user is unwilling to host surfers.
msgid "status.cant_host"
msgstr "não pode hospedar"

#. (noun) A message sent from a user to another user or to a group chat.
msgid "message.noun"
msgstr "mensagem"

#. (verb) The act of sending a message to another user or to a group chat.
msgid "message.verb"
msgstr "enviar mensagem"

#. (noun) Messages sent between users or to group chats.
msgid "messages"
msgstr "mensagens"

#. (noun) A thread for messages between two or more users.
msgid "chat"
msgstr "conversa"

#. (noun) Threads for messages between two or more users.
msgid "chats"
msgstr "conversas"
