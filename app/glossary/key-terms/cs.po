#. (noun) An event created by a user for others to attend.
msgid "event"
msgstr "událost"

#. (noun) Events created by users for others to attend.
msgid "events"
msgstr "události"

#. (noun) Another user confirmed as a friend using the friend feature.
msgid "friend"
msgstr "přítel"

#. (noun) A request to add another user as a friend.
msgid "friend_request"
msgstr "žádost o přátelství"

#. (noun) Requests to add other users as friends.
msgid "friend_requests"
msgstr "žádosti o přátelství"

#. (noun) Other users confirmed as friends using the friend feature.
msgid "friends"
msgstr "přátelé"

#. (noun) A community or event discussion that supports replies.
msgid "discussion"
msgstr "diskuse"
