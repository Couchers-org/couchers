#. (noun) The team behind Couchers.org.
msgid "couchers_org_team"
msgstr "Couchers.org Ekibi"

#. (noun) The document outlining the legal agreement for using Couchers.org.
msgid "terms_of_service"
msgstr "Hizmet Şartları"

#. (noun) The https://help.couchers.org website.
msgid "help_center"
msgstr "Yardım Merkezi"

#. (noun) A user's account password on Couchers.org.
msgid "password"
msgstr "şifre"

#. (verb) The action of logging in to Couchers.org.
msgid "log_in"
msgstr "giriş yap"

#. (verb) The act of volunteering with Couchers.org.
msgid "volunteer.verb"
msgstr "gönüllü ol"

#. (noun) A person volunteering with Couchers.org.
msgid "volunteer.noun"
msgstr "gönüllü"

#. (verb) The act of donating money to Couchers.org.
msgid "donate"
msgstr "bağış yap"

#. (verb) The act of donating money to Couchers.org.
msgid "donating"
msgstr "bağış yapmak"

#. (noun) Money donated to Couchers.org.
msgid "donations"
msgstr "bağışlar"

#. (noun) A problem with the platform reported by a user.
msgid "report_problem.problem"
msgstr "sorun"

#. (noun) Problems with the platform reported by a user.
msgid "report_problem.problems"
msgstr "sorunlar"

#. (noun) A moderator from the Couchers.org team.
msgid "moderator"
msgstr "moderatör"

#. (noun) Moderators from the Couchers.org team.
msgid "moderators"
msgstr "moderatörler"

#. (noun) A note sent to a user by a moderator.
msgid "moderator_note"
msgstr "moderatör notu"

#. (noun) Notes sent to a user by a moderator.
msgid "moderator_notes"
msgstr "moderatör notları"

#. (noun) A user account on Couchers.org.
msgid "account"
msgstr "hesap"

#. (verb) As a user, the action of deleting one's account.
msgid "account.delete"
msgstr "sil"

#. (adj) The state of a user's account which has been deleted.
msgid "account.deleted"
msgstr "silindi"

#. (verb) As a user, the action of recovering a previously deleted account.
msgid "account.recover"
msgstr "kurtar"

#. (adj) The state of a user's account which has been recovered.
msgid "account.recovered"
msgstr "kurtarıldı"

#. (noun) Someone with an account on Couchers.org.
msgid "user"
msgstr "kullanıcı"

#. (noun) Someone with an account on Couchers.org.
msgid "users"
msgstr "kullanıcılar"

#. (noun) A user's account identifier on Couchers.org.
msgid "username"
msgstr "kullanıcı adı"

#. (noun) A website/app session, from logging in to logging out.
msgid "session"
msgstr "oturum"

#. (noun) Website/app sessions, from logging in to logging out.
msgid "sessions"
msgstr "oturumlar"

#. (noun) A secret code used to make programmatic operations (call APIs) on behalf of a user.
msgid "api_key"
msgstr "API anahtarı"

#. (noun) A grouping of settings (account, notifications, etc.)
msgid "settings"
msgstr "ayarlar"

#. (noun) A user's account settings (notifications, theme, language, etc.).
msgid "account_settings"
msgstr "hesap ayarları"

#. (noun) An email or push notifications sent to a user.
msgid "notification"
msgstr "bildirim"

#. (noun) Email or push notifications sent to a user.
msgid "notifications"
msgstr "bildirimler"

#. (noun) Notifications sent to a user's phone or browser.
msgid "push_notifications"
msgstr "anlık bildirimler"

#. (noun) A process and the resulting status for verifying a user's identity.
msgid "strong_verification"
msgstr "Kuvvetli Doğrulama"

#. (noun) A process and the resulting status for verifying a user's phone number.
msgid "phone_verification"
msgstr "Telefon Numarası Doğrulama"

#. The section of a user profile with information relating their person.
msgid "profile.about_me"
msgstr "hakkımda"

#. The section of a user profile with information relating to their home.
msgid "profile.my_home"
msgstr "evim"
