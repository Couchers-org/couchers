# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — generated by `expo prebuild`. Local Expo modules under modules/
# ship their own ios/ and android/ sources, which must not be ignored.
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# Per-branch OTA preview pipeline (scripts/ota-bundle.mjs, expo export)
/ota-out/
/ota-expo-config.json

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# but the OTA code-signing certificates (public) are committed; the private keys are not
!certs/prod-ota-certificate.pem
!certs/staging-ota-certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

.env.local
submit/
proto/**

.env.local
