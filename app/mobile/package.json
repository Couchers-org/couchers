{
  "name": "couchers.org",
  "main": "expo-router/entry",
  "version": "1.4.0",
  "scripts": {
    "setup:local": "python3 ../scripts/dev-mobile-setup.py",
    "setup:local:restore": "python3 ../scripts/dev-mobile-setup.py --restore",
    "start": "expo start",
    "start:devtool": "APP_VARIANT=devtool expo start --scheme couchers-devtool",
    "start:localhost": "expo start --localhost",
    "start:local": "APP_VARIANT=staging LOCAL_UNSIGNED_BUILD=1 expo start --scheme couchers-staging",
    "build:protos": "bash ./ci-build-protos.sh",
    "eas-build-pre-install": "npm run build:protos",
    "android": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "android:local": "export APP_VARIANT=staging LOCAL_UNSIGNED_BUILD=1 SENTRY_DISABLE_AUTO_UPLOAD=true && expo prebuild --clean --platform android && expo run:android --device",
    "ios": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "ios:local": "export APP_VARIANT=staging LOCAL_UNSIGNED_BUILD=1 SENTRY_DISABLE_AUTO_UPLOAD=true && expo prebuild --clean --platform ios && expo run:ios --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "expo lint --fix && prettier --write .",
    "test": "jest",
    "fingerprints:check": "node scripts/fingerprints.mjs check",
    "fingerprints:write": "node scripts/fingerprints.mjs write",
    "release:ios:devtool": "eas build --platform ios --profile devtool --auto-submit",
    "release:ios:devtool:simulator": "eas build --platform ios --profile devtool-simulator",
    "release:ios:staging": "eas build --platform ios --profile staging --auto-submit",
    "release:ios:production": "eas build --platform ios --profile production --auto-submit",
    "release:android:devtool": "eas build --platform android --profile devtool-apk",
    "release:android:staging": "eas build --platform android --profile staging --auto-submit",
    "release:android:production": "eas build --platform android --profile production --auto-submit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/ubuntu": "^0.4.1",
    "@expo/cli": "~55.0.37",
    "@expo/vector-icons": "^15.0.3",
    "@expo/xcpretty": "^4.3.2",
    "@growthbook/growthbook": "^2.0.0",
    "@growthbook/growthbook-react": "^2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "~7.11.0",
    "expo": "~55.0.32",
    "expo-application": "~55.0.19",
    "expo-background-task": "~55.0.22",
    "expo-battery": "~55.0.17",
    "expo-build-properties": "~55.0.18",
    "expo-calendar": "~55.0.19",
    "expo-camera": "~55.0.23",
    "expo-cellular": "~55.0.17",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-eas-client": "~55.0.5",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-location": "~55.1.15",
    "expo-mail-composer": "~55.0.18",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-passkey": "^0.3.15",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.18",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "google-protobuf": "^4.0.0",
    "grpc-web": "^2.0.1",
    "i18next": "^25.0.2",
    "native-build-info": "file:./modules/native-build-info",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "sticky-store": "file:./modules/sticky-store"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/fingerprint": "0.16.8",
    "@testing-library/react-native": "^13.3.3",
    "@types/google-protobuf": "^3.15.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.5.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "knip": "^5.71.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
