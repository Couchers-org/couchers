    "@types/react-dom": "~19.1.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "knip": "^5.71.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2"
