{
  "name": "couchers.org",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "scripts": {
    "setup:local": "python3 ../scripts/dev-mobile-setup.py",
    "setup:local:restore": "python3 ../scripts/dev-mobile-setup.py --restore",
    "start": "expo start",
    "start:devtool": "APP_VARIANT=devtool expo start --scheme couchers-devtool",
    "start:localhost": "expo start --localhost",
    "build:protos": "bash ./ci-build-protos.sh",
    "eas-build-pre-install": "npm run build:protos",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "expo lint --fix && prettier --write .",
    "test": "jest",
    "fingerprints:check": "node scripts/fingerprints.mjs check",
    "fingerprints:write": "node scripts/fingerprints.mjs write",
    "release:ios:devtool": "eas build --platform ios --profile devtool --auto-submit",
    "release:ios:staging": "eas build --platform ios --profile staging --auto-submit",
    "release:ios:production": "eas build --platform ios --profile production --auto-submit",
    "release:android:devtool": "eas build --platform android --profile devtool-apk",
    "release:android:staging": "eas build --platform android --profile staging --auto-submit",
    "release:android:production": "eas build --platform android --profile production --auto-submit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/ubuntu": "^0.4.1",
    "@expo/cli": "^55.0.0-canary-20260105-6b962e6",
    "@expo/vector-icons": "^15.0.3",
    "@expo/xcpretty": "^4.3.2",
    "@growthbook/growthbook": "^1.6.5",
    "@growthbook/growthbook-react": "^1.6.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-background-task": "~1.0.10",
    "expo-battery": "~10.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-cellular": "~8.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-eas-client": "~1.0.0",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-passkey": "^0.3.15",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "^3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "google-protobuf": "^4.0.0",
    "grpc-web": "^2.0.1",
    "i18next": "^25.0.2",
    "native-build-info": "file:./modules/native-build-info",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "sticky-store": "file:./modules/sticky-store"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/fingerprint": "0.15.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/google-protobuf": "^3.15.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "knip": "^5.71.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
