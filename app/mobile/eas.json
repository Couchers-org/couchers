{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "staging": {
      "autoIncrement": true,
      "channel": "staging",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://dev-api.couchershq.org",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://next.couchershq.org",
        "EXPO_PUBLIC_COUCHERS_ENV": "preview",
        "EXPO_PUBLIC_FEATURE_FLAGS_URL": "https://next-static.couchershq.org/express/current.json"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.couchers.org",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://couchers.org",
        "EXPO_PUBLIC_COUCHERS_ENV": "prod",
        "EXPO_PUBLIC_FEATURE_FLAGS_URL": "https://cdn.couchers.org/express/current.json"
      }
    },
    "devtool": {
      "developmentClient": true,
      "distribution": "store",
      "autoIncrement": true,
      "channel": "development",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "devtool",
        "EXPO_PUBLIC_API_BASE_URL": "https://dev-api.couchershq.org",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://next.couchershq.org",
        "EXPO_PUBLIC_COUCHERS_ENV": "devtool",
        "EXPO_PUBLIC_FEATURE_FLAGS_URL": "https://gbapi.couchershq.org/api/features/sdk-f8lwseEODN02p"
      }
    },
    "devtool-apk": {
      "extends": "devtool",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6759947231"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": true
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6623776751"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": true
      }
    },
    "devtool": {
      "ios": {
        "ascAppId": "6772371797"
      }
    }
  }
}
